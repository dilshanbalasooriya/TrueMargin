# ==========================================
# TrueMargin Frontend Environment Configuration
# ==========================================

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend application/origin URL (used for OAuth redirects and auth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project credentials (from Supabase dashboard: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Next.js allowed development origins (comma-separated, for testing via LAN IP or mobile devices)
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.1.73