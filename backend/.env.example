# ==========================================
# TrueMargin Backend Environment Configuration
# ==========================================

# System Environment (development | production | staging)
ENVIRONMENT=development

# Database Connection (PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/truemargin

# Database Connection Pooling (optional, defaults: pool_size=10, max_overflow=20)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# DB_ECHO=false

# Supabase Auth & JWT Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# CORS Configuration
# Comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://192.168.1.73:3000
# Optional regex pattern for dynamically allowed origins (e.g. LAN testing)
ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+)(:\d+)?$

# Application & API Settings (optional overrides)
PROJECT_NAME="Unit Cost SaaS API"
PROJECT_VERSION="1.0.0"
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# Workspace & Localization Defaults
DEFAULT_CURRENCY=LKR
DEFAULT_COUNTRY=LK
